BootStrap: docker
From: rocker/tidyverse:latest

# https://sylabs.io/guides/3.5/user-guide/definition_files.html

%post -c /bin/bash
    # install packages 
    apt-get update -qq && apt-get -y --no-install-recommends install \
    openssh-server libglpk-dev libhdf5-dev patch libgit2-dev libuv1-dev libuv1 cmake

    # e.g. install ggtree
    R -e 'if (!requireNamespace("BiocManager", quietly = TRUE)) install.packages("BiocManager"); BiocManager::install(c("ggtree", "ComplexHeatmap", "BiocNeighbors"))'
    R -e 'install.packages("hdf5r")'
    R -e 'install.packages("ggpubr")'
    R -e 'install.packages("Seurat")'
    R -e 'install.packages(c("qs2", "devtools", "ggrepel", "remotes"))'
    
    # Reset the default CRAN repo so that user installed packages don't use a CRAN snapshot from built time
    echo "options(repos = c(CRAN = 'https://cran.rstudio.org'))" >> /usr/local/lib/R/etc/Rprofile.site

%environment
    # add env vars

%labels
    Name rstudio_hpc
